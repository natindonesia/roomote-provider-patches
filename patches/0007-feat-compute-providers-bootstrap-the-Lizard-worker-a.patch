+import {
+  type ComputeProviderLaunchMode,
+  type NamedPort,
+  serializeError,
+} from '@roomote/types';
+
+import { generateProxyPorts, getExposedPorts } from '../environment-machine';
+import { createComputeProviderClient } from '../factory';
+import { throwIfAborted } from '../modal/abort';
+import { loadSandboxBootstrapFiles } from '../sandbox/bootstrap-files';
+import { getWorkerRelease } from '../sandbox/worker-release-cache';
+import { loadLocalWorkerReleaseWithVersion } from '../sandbox/utils';
+import type {
+  ComputeProviderClient,
+  ComputeProviderMutationObserver,
+  LizardConfig,
+} from '../types';
+
+const REMOTE_BOOTSTRAP_DIR = '/tmp/roomote-bootstrap';
+const INSTALL_SCRIPT_PATH = `${REMOTE_BOOTSTRAP_DIR}/install-worker.sh`;
+const WORKER_TARBALL_PATH = `${REMOTE_BOOTSTRAP_DIR}/worker.tar.gz`;
+
+type LizardLifecycleClient = Pick<
+  ComputeProviderClient,
+  | 'vendor'
+  | 'createInstance'
+  | 'resumeFromStandby'
+  | 'resumeFromSnapshot'
+  | 'writeFiles'
+  | 'runCommand'
+  | 'getInstanceDomains'
+  | 'destroyInstance'
+  | 'enterStandby'
+>;
+
+export interface CreateLizardMachineOptions {
+  apiKey: string;
+  project: string;
+  apiUrl?: string;
+  template?: string;
+  size?: LizardConfig['size'];
+  timeoutMs?: number;
+  idempotencyKey?: string;
+  namedPorts?: NamedPort[];
+  proxyPorts?: Record<string, number>;
+  localTarballPath?: string;
+  signal?: AbortSignal;
+  bootstrapTimeoutMs?: number;
+  computeClient?: LizardLifecycleClient;
+  onMutation?: ComputeProviderMutationObserver;
+}
+
+export interface LizardMachine {
+  machineId: string;
+  proxyPorts: Record<string, number>;
+  sourceSnapshotId?: string;
+  domain: (port: number) => string;
+}
+
+export type LizardLaunchOptions =
+  | {
+      launchMode: 'fresh';
+      resumeHandle?: undefined;
+      sourceSnapshotId?: undefined;
+    }
+  | {
+      launchMode: 'task_standby';
+      resumeHandle: string;
+      sourceSnapshotId?: undefined;
+    }
+  | {
+      /** Fork a named snapshot (environment template). */
+      launchMode: 'environment_snapshot' | 'task_snapshot';
+      sourceSnapshotId: string;
+      resumeHandle?: undefined;
+    };
+
+export type CreateLizardMachineParams = CreateLizardMachineOptions &
+  LizardLaunchOptions;
+
+export async function createLizardMachine(
+  options: CreateLizardMachineParams,
+): Promise<LizardMachine> {
+  throwIfAborted(options.signal);
+
+  const proxyPorts =
+    options.proxyPorts ?? generateProxyPorts(options.namedPorts);
+  const ports = getExposedPorts(options.namedPorts, proxyPorts);
+  const forkSnapshotId =
+    options.launchMode === 'environment_snapshot' ||
+    options.launchMode === 'task_snapshot'
+      ? options.sourceSnapshotId
+      : undefined;
+
+  // Fresh and forked sandboxes need the worker installed; standby resumes
+  // reuse the same sandbox as-is. Forks restore a snapshot that already holds a
+  // worker, but it is refreshed so the shipped worker matches the current
+  // runtime protocol.
+  const release =
+    options.launchMode !== 'task_standby'
+      ? options.localTarballPath
+        ? loadLocalWorkerReleaseWithVersion(options.localTarballPath)
+        : await getWorkerRelease()
+      : undefined;
+
+  const config: LizardConfig = {
+    apiKey: options.apiKey,
+    project: options.project,
+    ...(options.apiUrl ? { apiUrl: options.apiUrl } : {}),
+    ...(options.template ? { template: options.template } : {}),
+    ...(options.size ? { size: options.size } : {}),
+    ...(options.timeoutMs !== undefined
+      ? { timeoutMs: options.timeoutMs }
+      : {}),
+  };
+
+  const computeClient =
+    options.computeClient ??
+    createComputeProviderClient({ provider: 'lizard', config });
+
+  if (computeClient.vendor !== 'lizard') {
+    throw new Error('createLizardMachine requires a Lizard compute client');
+  }
+
+  const operation = options.resumeHandle
+    ? 'resume_from_standby'
+    : forkSnapshotId
+      ? 'resume_from_snapshot'
+      : 'create_instance';
+  const operationLabel = options.resumeHandle
+    ? 'resumeFromStandby'
+    : forkSnapshotId
+      ? 'resumeFromSnapshot'
+      : 'createInstance';
+  const mutationSourceSnapshotId =
+    options.resumeHandle ?? forkSnapshotId ?? null;
+
+  await options.onMutation?.({
+    provider: 'lizard',
+    operation,
+    eventType: 'started',
+    message: options.resumeHandle
+      ? `Calling resumeFromStandby for Lizard sandbox ${options.resumeHandle}.`
+      : forkSnapshotId
+        ? `Calling resumeFromSnapshot for Lizard sandbox from ${forkSnapshotId}.`
+        : 'Calling createInstance for Lizard.',
+    details: {
+      launchMode: options.launchMode as ComputeProviderLaunchMode,
+      sourceSnapshotId: mutationSourceSnapshotId,
+      ports,
+    },
+  });
+
+  let created: { instanceId: string };
+  try {
+    if (options.resumeHandle) {
+      if (!computeClient.resumeFromStandby) {
+        throw new Error(
+          'Lizard compute client does not support standby resume',
+        );
+      }
+
+      created = await computeClient.resumeFromStandby({
+        resumeHandle: options.resumeHandle,
+        ports,
+        signal: options.signal,
+      });
+    } else if (forkSnapshotId) {
+      created = await computeClient.resumeFromSnapshot({
+        sourceSnapshotId: forkSnapshotId,
+        idempotencyKey: options.idempotencyKey,
+        ports,
+        metadata: release
+          ? { workerReleaseTag: `worker-v${release.version}` }
+          : undefined,
+        signal: options.signal,
+      });
+    } else {
+      created = await computeClient.createInstance({
+        idempotencyKey: options.idempotencyKey,
+        ports,
+        metadata: release
+          ? { workerReleaseTag: `worker-v${release.version}` }
+          : undefined,
+        signal: options.signal,
+      });
+    }
+
+    await options.onMutation?.({
+      provider: 'lizard',
+      operation,
+      eventType: 'completed',
+      instanceId: created.instanceId,
+      message: `${operationLabel} completed for Lizard sandbox ${created.instanceId}.`,
+      details: {
+        launchMode: options.launchMode as ComputeProviderLaunchMode,
+        sourceSnapshotId: mutationSourceSnapshotId,
+        ports,
+      },
+    });
+  } catch (error) {
+    await options.onMutation?.({
+      provider: 'lizard',
+      operation,
+      eventType: 'failed',
+      message: `${operationLabel} failed for Lizard.`,
+      details: {
+        launchMode: options.launchMode as ComputeProviderLaunchMode,
+        sourceSnapshotId: mutationSourceSnapshotId,
+        ports,
+        error: serializeError(error).message,
+      },
+    });
+    throw error;
+  }
+
+  if (release) {
+    const bootstrapTimeoutSignal = options.bootstrapTimeoutMs
+      ? AbortSignal.timeout(options.bootstrapTimeoutMs)
+      : undefined;
+    const bootstrapSignal =
+      bootstrapTimeoutSignal && options.signal
+        ? AbortSignal.any([bootstrapTimeoutSignal, options.signal])
+        : (bootstrapTimeoutSignal ?? options.signal);
+
+    try {
+      const { files } = loadSandboxBootstrapFiles(REMOTE_BOOTSTRAP_DIR);
+      files.push({ path: WORKER_TARBALL_PATH, content: release.archive });
+
+      await computeClient.writeFiles({
+        instanceId: created.instanceId,
+        files,
+        signal: bootstrapSignal,
+      });
+
+      const install = await computeClient.runCommand({
+        instanceId: created.instanceId,
+        cmd: 'bash',
+        args: [INSTALL_SCRIPT_PATH],
+        env: {
+          // Lizard runs sandbox commands as root; install and launch must agree
+          // on HOME so the worker's state lands where it later looks for it.
+          HOME: '/root',
+          WORKER_RELEASE_ARCHIVE_PATH: WORKER_TARBALL_PATH,
+        },
+        signal: bootstrapSignal,
+      });
+
+      if (install.exitCode !== 0) {
+        throw new Error(
+          `Lizard worker install failed with exit code ${install.exitCode}: ${install.stderr ?? install.stdout ?? 'no output'}`,
+        );
+      }
+    } catch (error) {
+      await computeClient
+        .destroyInstance({ instanceId: created.instanceId })
+        .catch(() => {});
+      throw error;
+    }
+  }
+
+  let domains: Record<string, string> | undefined;
+  try {
+    domains = ports.length
+      ? (
+          await computeClient.getInstanceDomains?.({
+            instanceId: created.instanceId,
+            ports,
+            signal: options.signal,
+          })
+        )?.domains
+      : {};
+    if (ports.length && !domains) {
+      throw new Error('Lizard compute client does not support preview URLs');
+    }
+  } catch (error) {
+    const cleanup = options.resumeHandle
+      ? computeClient.enterStandby?.({ instanceId: created.instanceId })
+      : computeClient.destroyInstance({ instanceId: created.instanceId });
+    await cleanup?.catch(() => {});
+    throw error;
+  }
+
+  const sourceSnapshotId = options.resumeHandle ?? forkSnapshotId;
+
+  return {
+    machineId: created.instanceId,
+    proxyPorts,
+    ...(sourceSnapshotId ? { sourceSnapshotId } : {}),
+    domain: (port: number) => {
+      const domain = domains?.[String(port)];
+
+      if (!domain) {
+        throw new Error(
+          `Lizard sandbox ${created.instanceId} has no URL for port ${port}`,
+        );
+      }
+
+      return domain;
+    },
+  };
+}
