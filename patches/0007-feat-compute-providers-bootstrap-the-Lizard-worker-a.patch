index 0000000..3f8cebb
--- /dev/null
+++ b/packages/compute-providers/src/worker-env/lizard.ts
@@ -0,0 +1,33 @@
+import { buildBaseWorkerEnv } from './base';
+import { buildWorkerContextEnv } from './context';
+import type { BuildWorkerEnvOptions } from './types';
+
+export function buildLizardWorkerEnv({
+  authToken,
+  sandboxExpiresAtMs,
+  extraEnv,
+  deploymentSlug,
+  environmentId,
+  size,
+}: BuildWorkerEnvOptions & {
+  deploymentSlug?: string;
+  size?: string;
+}): Record<string, string> {
+  return {
+    ...buildBaseWorkerEnv({
+      authToken,
+      sandboxExpiresAtMs,
+      extraEnv,
+      environmentId,
+    }),
+    ...buildWorkerContextEnv({
+      provider: 'lizard',
+      fingerprint: size,
+      fingerprintKind: size ? 'runtime' : undefined,
+      deploymentSlug,
+      environmentId,
+    }),
+    // Lizard sandbox commands run as root, so the worker's HOME is /root.
+    HOME: '/root',
+  };
+}
