 .../src/compute-providers/capabilities.ts     | 30 +++++++++++++++++++
 .../src/compute-providers/compute-provider.ts | 13 ++++++++
 .../src/compute-providers/worker-context.ts   |  2 ++
 4 files changed, 71 insertions(+)

