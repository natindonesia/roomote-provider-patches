diff --git a/packages/types/src/compute-providers/capabilities.ts b/packages/types/src/compute-providers/capabilities.ts
index ee3cf87..9d7e45e 100644
--- a/packages/types/src/compute-providers/capabilities.ts
+++ b/packages/types/src/compute-providers/capabilities.ts
@@ -139,6 +139,34 @@ export const BOX_CAPABILITIES: ComputeProviderCapabilities = {
   credentialEgress: 'api_proxy',
 };
 
+/**
+ * Fly.io Sprites are persistent, hardware-isolated Ubuntu VMs.
+ *
+ * Snapshots are deliberately unsupported: the Sprites checkpoint API restores
+ * into the *same* Sprite (`POST /v1/sprites/{name}/checkpoints/{id}/restore`),
+ * so a checkpoint cannot back Roomote's snapshot-then-destroy-then-fork
+ * contract. Sprites instead idle to `warm`/`cold` on their own, which is
+ * exactly the standby-resume shape.
+ */
+export const SPRITES_CAPABILITIES: ComputeProviderCapabilities = {
+  supportsCreateInstance: true,
+  supportsDestroyInstance: true,
+  supportsCommandExecution: true,
+  // Poll-based streaming over a detached-command log file read via the
+  // filesystem API.
+  supportsCommandOutputStreaming: true,
+  supportsCommandOutputLookup: true,
+  supportsSnapshots: false,
+  supportsStandbyResume: true,
+  supportsResume: true,
+  supportsFileWrite: true,
+  // Sprites are full Ubuntu VMs with Docker pre-installed.
+  supportsDockerProjects: true,
+  // Substitutes are used through the API-side credential egress proxy; see
+  // MODAL_CAPABILITIES.
+  credentialEgress: 'api_proxy',
+};
+
 export const AZURE_CAPABILITIES: ComputeProviderCapabilities = {
   supportsCreateInstance: true,
   supportsDestroyInstance: true,
@@ -177,6 +205,8 @@ export function getComputeProviderCapabilities(
       return BLAXEL_CAPABILITIES;
     case 'box':
       return BOX_CAPABILITIES;
+    case 'sprites':
+      return SPRITES_CAPABILITIES;
     case 'azure':
       return AZURE_CAPABILITIES;
     default: {
