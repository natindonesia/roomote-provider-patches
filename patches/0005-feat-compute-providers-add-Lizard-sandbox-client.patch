+import { randomUUID } from 'node:crypto';
+
+import {
+  NotFoundError,
+  Sandbox,
+  type SandboxInfo,
+  type SandboxSnapshot,
+} from '@lizard-build/sdk';
+import {
+  LIZARD_CAPABILITIES as LIZARD_CAPABILITIES_VALUE,
+  type ComputeProvider,
+} from '@roomote/types';
+
+import { sleepWithSignal, throwIfAborted } from '../modal/abort';
+import type {
+  CommandOutputEvent,
+  ComputeInstanceStatus,
+  ComputeProviderCapabilities,
+  ComputeProviderClient,
+  CreateInstanceInput,
+  CreateSnapshotInput,
+  CreateSnapshotResult,
+  CreatedInstance,
+  DestroyInstanceInput,
+  DestroyInstanceResult,
+  EnterStandbyInput,
+  EnterStandbyResult,
+  GetCommandOutputInput,
+  GetInstanceDomainsInput,
+  GetInstanceDomainsResult,
+  GetInstanceStatusInput,
+  GetInstanceStatusResult,
+  InstanceSummary,
+  ListInstancesInput,
+  LizardConfig,
+  ResumeFromStandbyInput,
+  ResumeInstanceInput,
+  RunCommandInput,
+  RunCommandResult,
+  StreamCommandOutputInput,
+  WriteFileInput,
+} from '../types';
+
+export const DEFAULT_LIZARD_TEMPLATE = 'base';
+export const DEFAULT_LIZARD_API_URL = 'https://lizard.build';
+
+/** Detached commands write here; the command id is the log path. */
+export const LIZARD_DETACHED_LOG_DIR = '/tmp/roomote-exec';
+export const LIZARD_COMMAND_ID_PREFIX = 'lizard-log:';
+
+const DEFAULT_POLL_INTERVAL_MS = 1_000;
+const DEFAULT_READINESS_TIMEOUT_MS = 5 * 60_000;
+const DEFAULT_SNAPSHOT_TIMEOUT_MS = 20 * 60_000;
+const EXIT_SENTINEL = '__ROOMOTE_EXIT__';
+
+type LizardSize = NonNullable<LizardConfig['size']>;
+
+/** Guest memory per size, per the platform limits table. */
+export const LIZARD_SIZE_MEMORY_MIB: Record<LizardSize, number> = {
+  nano: 1 * 1024,
+  mini: 2 * 1024,
+  small: 4 * 1024,
+  medium: 8 * 1024,
+  large: 16 * 1024,
+  big: 32 * 1024,
+};
+
+const LIZARD_SIZE_ORDER: readonly LizardSize[] = [
+  'nano',
+  'mini',
+  'small',
+  'medium',
+  'large',
+  'big',
+];
+
+export class LizardClient implements ComputeProviderClient {
+  public readonly vendor: ComputeProvider = 'lizard';
+
+  public readonly capabilities: ComputeProviderCapabilities =
+    LIZARD_CAPABILITIES_VALUE;
+
+  private readonly connection: {
+    apiKey: string;
+    apiUrl: string;
+    project: string;
+  };
+
+  public constructor(private readonly config: LizardConfig) {
+    if (!config.apiKey) {
+      throw new Error('Lizard requires an apiKey');
+    }
+
+    if (!config.project) {
+      throw new Error(
+        'Lizard requires a project; every sandbox must be attributed to one',
+      );
+    }
+
+    this.connection = {
+      apiKey: config.apiKey,
+      apiUrl: config.apiUrl ?? DEFAULT_LIZARD_API_URL,
+      project: config.project,
+    };
+  }
+
+  public async listInstances(
+    input: ListInstancesInput,
+  ): Promise<InstanceSummary[]> {
+    throwIfAborted(input.signal);
+
+    const sandboxes = await Sandbox.list({
+      ...this.connection,
+      projectId: this.connection.project,
+    });
+
+    return sandboxes.map(summarizeSandbox);
+  }
+
+  public async getInstanceStatus(
+    input: GetInstanceStatusInput,
+  ): Promise<GetInstanceStatusResult> {
+    try {
+      const sandbox = await Sandbox.connect(input.instanceId, this.connection);
+      const info = await sandbox.getInfo();
+
+      return { status: mapSandboxState(info.status) };
+    } catch (error) {
+      if (isNotFound(error)) {
+        return { status: 'stopped' };
+      }
+
+      throw error;
+    }
+  }
+
+  public async createInstance(
+    input: CreateInstanceInput,
+  ): Promise<CreatedInstance> {
+    throwIfAborted(input.signal);
+
+    const size = this.resolveSize(input.metadata?.['requiredMemoryMiB']);
+
+    const sandbox = await Sandbox.create(
+      this.config.template ?? DEFAULT_LIZARD_TEMPLATE,
+      {
+        ...this.connection,
+        ...(size ? { size } : {}),
+        ...(this.config.timeoutMs !== undefined
+          ? { timeoutMs: this.config.timeoutMs }
+          : {}),
+        ...(input.metadata ? { metadata: input.metadata } : {}),
+      },
+    );
+
+    try {
+      const domains = await this.resolveDomains(
+        sandbox,
+        input.ports,
+        input.signal,
+      );
+
+      return {
+        instanceId: sandbox.sandboxId,
+        status: 'running',
+        ...(domains ? { domains } : {}),
+      };
+    } catch (error) {
+      await sandbox.kill().catch(() => {});
+      throw error;
+    }
+  }
+
+  public async destroyInstance(
+    input: DestroyInstanceInput,
+  ): Promise<DestroyInstanceResult> {
+    try {
+      const sandbox = await Sandbox.connect(input.instanceId, this.connection);
+
+      await sandbox.kill();
+    } catch (error) {
+      if (isNotFound(error)) {
+        return {};
+      }
+
+      throw error;
+    }
+
+    return {};
+  }
+
+  /**
+   * Lizard pauses keep files and stop compute, which is the standby shape.
+   * The sandbox id is itself the resume handle.
+   */
+  public async enterStandby(
+    input: EnterStandbyInput,
+  ): Promise<EnterStandbyResult> {
+    throwIfAborted(input.signal);
+
+    const sandbox = await Sandbox.connect(input.instanceId, this.connection);
+
+    await sandbox.pause();
+    await sandbox.waitForStatus('paused');
+
+    return { resumeHandle: input.instanceId };
+  }
+
+  public async resumeFromStandby(
+    input: ResumeFromStandbyInput,
+  ): Promise<CreatedInstance> {
+    throwIfAborted(input.signal);
+
+    const sandbox = await Sandbox.connect(input.resumeHandle, this.connection);
+
+    await sandbox.resume();
+    await sandbox.waitForStatus('running');
+
+    const domains = await this.resolveDomains(
+      sandbox,
+      input.ports,
+      input.signal,
+    );
+
+    return {
+      instanceId: input.resumeHandle,
+      sourceSnapshotId: input.resumeHandle,
+      status: 'running',
+      ...(domains ? { domains } : {}),
+    };
+  }
+
+  public async getInstanceDomains(
+    input: GetInstanceDomainsInput,
+  ): Promise<GetInstanceDomainsResult> {
+    const sandbox = await Sandbox.connect(input.instanceId, this.connection);
+
+    return {
+      domains:
+        (await this.resolveDomains(sandbox, input.ports, input.signal)) ?? {},
+    };
+  }
+
+  public async runCommand(input: RunCommandInput): Promise<RunCommandResult> {
+    throwIfAborted(input.signal);
+
+    const sandbox = await Sandbox.connect(input.instanceId, this.connection);
+
+    if (input.detached) {
+      return this.runDetachedCommand(sandbox, input);
+    }
+
+    const result = await sandbox.process.exec(
+      toArgv(input),
+      {
+        ...(input.cwd ? { workdir: input.cwd } : {}),
+        ...(input.env ? { envs: input.env } : {}),
+        ...(input.onOutput
+          ? {
+              onStdout: (data: string) =>
+                input.onOutput?.({ stream: 'stdout', data }),
+              onStderr: (data: string) =>
+                input.onOutput?.({ stream: 'stderr', data }),
+            }
+          : {}),
+      },
+    );
+
+    return {
+      exitCode: result.exitCode,
+      ...(result.stdout ? { stdout: result.stdout } : {}),
+      ...(result.stderr ? { stderr: result.stderr } : {}),
+    };
+  }
+
+  private async runDetachedCommand(
+    sandbox: Awaited<ReturnType<typeof Sandbox.connect>>,
+    input: RunCommandInput,
+  ): Promise<RunCommandResult> {
+    const logPath = `${LIZARD_DETACHED_LOG_DIR}/${randomUUID()}.log`;
+    const commandId = `${LIZARD_COMMAND_ID_PREFIX}${logPath}`;
+    const script = buildDetachedScript(input, logPath);
+
+    await sandbox.process.exec(['bash', '-lc', script], {
+      ...(input.env ? { envs: input.env } : {}),
+    });
+
+    const output = await this.readLog(sandbox, logPath);
+
+    if (output !== null) {
+      const parsed = parseMarkedOutput(output);
+
+      if (parsed.exitCode !== null) {
+        emitParsed(parsed, input.onOutput);
+
+        return {
+          commandId,
+          exitCode: parsed.exitCode,
+          ...(parsed.stdout ? { stdout: parsed.stdout } : {}),
+          ...(parsed.stderr ? { stderr: parsed.stderr } : {}),
+        };
+      }
+    }
+
+    return { commandId, exitCode: null };
+  }
+
+  public async *streamCommandOutput(
+    input: StreamCommandOutputInput,
+  ): AsyncIterable<CommandOutputEvent> {
+    const logPath = parseLizardCommandId(input.commandId);
+    const sandbox = await Sandbox.connect(input.instanceId, this.connection);
+    let emitted = '';
+
+    while (true) {
+      throwIfAborted(input.signal);
+
+      const content = await this.readLog(sandbox, logPath);
+
+      if (content !== null && content.length > emitted.length) {
+        yield { stream: 'stdout', data: content.slice(emitted.length) };
+        emitted = content;
+      }
+
+      if (parseMarkedOutput(emitted).exitCode !== null) {
+        return;
+      }
+
+      await sleepWithSignal(this.pollIntervalMs(), input.signal);
+    }
+  }
+
+  public async getCommandOutput(input: GetCommandOutputInput): Promise<string> {
+    const logPath = parseLizardCommandId(input.commandId);
+    const sandbox = await Sandbox.connect(input.instanceId, this.connection);
+
+    return (await this.readLog(sandbox, logPath)) ?? '';
+  }
+
+  public async writeFiles(input: WriteFileInput): Promise<void> {
+    const sandbox = await Sandbox.connect(input.instanceId, this.connection);
+
+    for (const file of input.files) {
+      throwIfAborted(input.signal);
+
+      const parent = file.path.replace(/\/[^/]+$/, '');
+
+      if (parent && parent !== '/') {
+        await sandbox.process.exec(['mkdir', '-p', parent]);
+      }
+
+      await sandbox.fs.write(file.path, new Uint8Array(file.content));
+    }
+  }
+
+  public async createSnapshot(
+    input: CreateSnapshotInput,
+  ): Promise<CreateSnapshotResult> {
+    throwIfAborted(input.signal);
+
+    const sandbox = await Sandbox.connect(input.instanceId, this.connection);
+    const snapshotName = deriveLizardSnapshotName(input.instanceId);
+    const snapshot = await sandbox.snapshot(snapshotName);
+
+    const ready = await Sandbox.waitForSnapshot(snapshot.id, {
+      apiKey: this.connection.apiKey,
+      apiUrl: this.connection.apiUrl,
+      ...(this.config.readinessTimeoutMs !== undefined
+        ? { timeoutMs: this.config.readinessTimeoutMs }
+        : {}),
+    });
+
+    if (ready.status === 'failed') {
+      throw new Error(
+        `Lizard snapshot ${snapshot.id} failed: ${ready.error ?? 'unknown error'}`,
+      );
+    }
+
+    // Persist before tearing the source down: the snapshot id is the only
+    // handle to the artifact once the sandbox is gone.
+    await input.onSnapshotCreated?.(snapshot.id);
+
+    await sandbox.kill().catch(() => {});
+
+    return { snapshotId: snapshot.id };
+  }
+
+  public async resumeFromSnapshot(
+    input: ResumeInstanceInput,
+  ): Promise<CreatedInstance> {
+    throwIfAborted(input.signal);
+
+    const sandbox = await Sandbox.restore(input.sourceSnapshotId, {
+      apiKey: this.connection.apiKey,
+      apiUrl: this.connection.apiUrl,
+      projectId: this.connection.project,
+      ...(this.config.timeoutMs !== undefined
+        ? { timeoutMs: this.config.timeoutMs }
+        : {}),
+    });
+
+    const domains = await this.resolveDomains(
+      sandbox,
+      input.ports,
+      input.signal,
+    );
+
+    return {
+      instanceId: sandbox.sandboxId,
+      status: 'running',
+      sourceSnapshotId: input.sourceSnapshotId,
+      ...(domains ? { domains } : {}),
+    };
+  }
+
+  /**
+   * Every requested port is published individually, so multi-port Roomote
+   * environments work without a service registry.
+   */
+  private async resolveDomains(
+    sandbox: Awaited<ReturnType<typeof Sandbox.create>>,
+    ports: number[] | undefined,
+    signal?: AbortSignal,
+  ): Promise<Record<string, string> | undefined> {
+    if (!ports || ports.length === 0) {
+      return undefined;
+    }
+
+    const domains: Record<string, string> = {};
+
+    for (const port of ports) {
+      throwIfAborted(signal);
+
+      try {
+        const exposed = await sandbox.exposePort(port);
+
+        // The URL carries `?lizard_token=` so a browser preview works without
+        // an extra header, matching the other providers' private URLs.
+        domains[String(port)] = exposed.url;
+      } catch (error) {
+        console.warn(
+          `[LizardClient] Failed to expose port ${port} on ${sandbox.sandboxId}: ${formatError(error)}`,
+        );
+      }
+    }
+
+    return Object.keys(domains).length > 0 ? domains : undefined;
+  }
+
+  private async readLog(
+    sandbox: Awaited<ReturnType<typeof Sandbox.connect>>,
+    logPath: string,
+  ): Promise<string | null> {
+    try {
+      return await sandbox.fs.read(logPath);
+    } catch (error) {
+      if (isNotFound(error)) {
+        return null;
+      }
+
+      throw error;
+    }
+  }
+
+  private resolveSize(requiredMemoryMiB?: string): LizardSize | undefined {
+    const configured = this.config.size;
+    const required = requiredMemoryMiB ? Number(requiredMemoryMiB) : 0;
+    const minimum = Math.max(
+      Number.isFinite(required) ? required : 0,
+      configured ? LIZARD_SIZE_MEMORY_MIB[configured] : 0,
+    );
+
+    if (minimum <= 0) {
+      return configured;
+    }
+
+    const resolved = LIZARD_SIZE_ORDER.find(
+      (size) => LIZARD_SIZE_MEMORY_MIB[size] >= minimum,
+    );
+
+    if (!resolved) {
+      throw new Error(
+        `Lizard supports at most ${LIZARD_SIZE_MEMORY_MIB.big} MiB, but this task requires ${minimum} MiB`,
+      );
+    }
+
+    return resolved;
+  }
+
+  private pollIntervalMs(): number {
+    return this.config.pollIntervalMs ?? DEFAULT_POLL_INTERVAL_MS;
+  }
+}
+
+function summarizeSandbox(info: SandboxInfo): InstanceSummary {
+  return {
+    instanceId: info.sandboxId,
+    status: mapSandboxState(info.status),
+    timeoutRemainingMs: Math.max(
+      0,
+      new Date(info.endAt).getTime() - Date.now(),
+    ),
+    ...(info.startedAt ? { createdAt: new Date(info.startedAt) } : {}),
+  };
+}
+
+function mapSandboxState(state: string | undefined): ComputeInstanceStatus {
+  switch (state) {
+    case 'running':
+      return 'running';
+    case 'paused':
+      return 'stopped';
+    case 'pausing':
+      return 'stopping';
+    case 'failed':
+      return 'failed';
+    case 'pending':
+    case 'starting':
+    case 'resuming':
+      return 'pending';
+    default:
+      return 'unknown';
+  }
+}
+
+function toArgv(input: RunCommandInput): string | string[] {
+  return input.args && input.args.length > 0
+    ? [input.cmd, ...input.args]
+    : input.cmd;
+}
+
+function buildDetachedScript(input: RunCommandInput, logPath: string): string {
+  const command = [input.cmd, ...(input.args ?? [])].map(shellQuote).join(' ');
+  const withCwd = input.cwd ? `cd ${shellQuote(input.cwd)} && ` : '';
+  const inner = `${withCwd}${command}; printf '\\n${EXIT_SENTINEL}%s\\n' "$?"`;
+
+  return [
+    `mkdir -p ${shellQuote(LIZARD_DETACHED_LOG_DIR)}`,
+    `setsid bash -lc ${shellQuote(inner)} > ${shellQuote(logPath)} 2>&1 < /dev/null &`,
+    'echo started',
+  ].join('\n');
+}
+
+interface ParsedOutput {
+  stdout: string;
+  stderr: string;
+  exitCode: number | null;
+}
+
+function parseMarkedOutput(raw: string): ParsedOutput {
+  const markerIndex = raw.lastIndexOf(EXIT_SENTINEL);
+
+  if (markerIndex === -1) {
+    return { stdout: raw, stderr: '', exitCode: null };
+  }
+
+  const exitMatch = raw
+    .slice(markerIndex + EXIT_SENTINEL.length)
+    .match(/^(\d+)/);
+
+  return {
+    stdout: raw.slice(0, markerIndex).replace(/\n+$/, ''),
+    stderr: '',
+    exitCode: exitMatch ? Number(exitMatch[1]) : null,
+  };
+}
+
+function emitParsed(
+  parsed: ParsedOutput,
+  onOutput?: (event: CommandOutputEvent) => void,
+): void {
+  if (!onOutput) return;
+
+  if (parsed.stdout) onOutput({ stream: 'stdout', data: parsed.stdout });
+}
+
+function parseLizardCommandId(commandId: string): string {
+  if (!commandId.startsWith(LIZARD_COMMAND_ID_PREFIX)) {
+    throw new Error(
+      `Invalid Lizard command ID "${commandId}"; expected "${LIZARD_COMMAND_ID_PREFIX}<logPath>"`,
+    );
+  }
+
+  return commandId.slice(LIZARD_COMMAND_ID_PREFIX.length);
+}
+
+export function deriveLizardSnapshotName(instanceId: string): string {
+  const sanitized = instanceId
+    .toLowerCase()
+    .replace(/[^a-z0-9._-]/g, '-')
+    .slice(0, 24);
+  const suffix = randomUUID().replace(/-/g, '').slice(0, 12);
+
+  return `roomote-snap-${sanitized}-${suffix}`;
+}
+
+function isNotFound(error: unknown): boolean {
+  return error instanceof NotFoundError;
+}
+
+function formatError(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+const SHELL_SAFE_PATTERN = /^[A-Za-z0-9_@%+=:,./-]+$/;
+
+function shellQuote(value: string): string {
+  if (value.length > 0 && SHELL_SAFE_PATTERN.test(value)) {
+    return value;
+  }
+
+  return `'${value.replaceAll("'", `'\\''`)}'`;
+}
+
+export type { SandboxSnapshot };
