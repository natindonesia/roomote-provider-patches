From 6a1d07969f72c81147d4fad04a5df81f5ccf53dd Mon Sep 17 00:00:00 2001
From: Ticlext-Altihaf <hi@ticlext.top>
Date: Thu, 19 Nov 2026 03:28:06 +0100
Subject: [PATCH 4/6] feat(types): register lizard as a compute provider

Lizard is the only provider of the set that satisfies the full Roomote
contract: native exit codes, per-port preview URLs, filesystem snapshots
restored into the same project, and pause/resume standby. It is therefore
listed in both the snapshot-capable and standby-capable sets.
---
 packages/compute-providers/src/types.ts       | 26 +++++++++++++++++++
 .../src/compute-providers/capabilities.ts     | 26 +++++++++++++++++++
 .../src/compute-providers/compute-provider.ts | 14 ++++++++++
 .../src/compute-providers/worker-context.ts   |  2 ++
 4 files changed, 68 insertions(+)

diff --git a/packages/compute-providers/src/types.ts b/packages/compute-providers/src/types.ts
index f72061a..d34c15e 100644
--- a/packages/compute-providers/src/types.ts
+++ b/packages/compute-providers/src/types.ts
@@ -473,6 +473,28 @@ export interface SpritesConfig {
   fetchImpl?: typeof fetch;
 }
 
+export interface LizardConfig {
+  /** Lizard API key (`LIZARD_API_KEY`). */
+  apiKey: string;
+  /**
+   * Project every sandbox is attributed to — an id, slug, or name
+   * (`LIZARD_PROJECT`). Required: Lizard bills sandboxes to a project.
+   */
+  project: string;
+  /** Lizard API base URL (`LIZARD_API_URL`). Defaults to the cloud. */
+  apiUrl?: string;
+  /** Catalog template to boot (`LIZARD_TEMPLATE`). Defaults to `base`. */
+  template?: string;
+  /** Explicit sandbox size (`LIZARD_SIZE`); otherwise derived from memory. */
+  size?: 'nano' | 'mini' | 'small' | 'medium' | 'large' | 'big';
+  /** Sandbox lifetime in milliseconds, applied at create and restore. */
+  timeoutMs?: number;
+  /** Maximum time to wait for snapshot readiness. */
+  readinessTimeoutMs?: number;
+  /** Poll interval for detached-command log streaming. */
+  pollIntervalMs?: number;
+}
+
 export type ComputeProviderFactoryOptions = (
   | {
       provider: 'modal';
@@ -511,6 +533,10 @@ export type ComputeProviderFactoryOptions = (
       provider: 'sprites';
       config?: SpritesConfig;
     }
+  | {
+      provider: 'lizard';
+      config?: LizardConfig;
+    }
   | {
       provider: 'azure';
       config?: AzureConfig;
diff --git a/packages/types/src/compute-providers/capabilities.ts b/packages/types/src/compute-providers/capabilities.ts
index 9d7e45e..6e71d17 100644
--- a/packages/types/src/compute-providers/capabilities.ts
+++ b/packages/types/src/compute-providers/capabilities.ts
@@ -167,6 +167,30 @@ export const SPRITES_CAPABILITIES: ComputeProviderCapabilities = {
   credentialEgress: 'api_proxy',
 };
 
+/**
+ * Lizard sandboxes are Firecracker microVMs with a real SDK surface, so this
+ * provider supports the full Roomote contract: native exit codes, per-port
+ * preview URLs, filesystem snapshots restored into the same project, and
+ * pause/resume standby.
+ */
+export const LIZARD_CAPABILITIES: ComputeProviderCapabilities = {
+  supportsCreateInstance: true,
+  supportsDestroyInstance: true,
+  supportsCommandExecution: true,
+  supportsCommandOutputStreaming: true,
+  // Detached commands append to a log file read back through the SDK fs API.
+  supportsCommandOutputLookup: true,
+  supportsSnapshots: true,
+  supportsStandbyResume: true,
+  supportsResume: true,
+  supportsFileWrite: true,
+  // Full Linux guest; Docker runs inside the microVM.
+  supportsDockerProjects: true,
+  // Substitutes are used through the API-side credential egress proxy; see
+  // MODAL_CAPABILITIES.
+  credentialEgress: 'api_proxy',
+};
+
 export const AZURE_CAPABILITIES: ComputeProviderCapabilities = {
   supportsCreateInstance: true,
   supportsDestroyInstance: true,
@@ -207,6 +231,8 @@ export function getComputeProviderCapabilities(
       return BOX_CAPABILITIES;
     case 'sprites':
       return SPRITES_CAPABILITIES;
+    case 'lizard':
+      return LIZARD_CAPABILITIES;
     case 'azure':
       return AZURE_CAPABILITIES;
     default: {
